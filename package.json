{
  "name": "compy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "astro build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "preview": "astro preview",
    "build-taxonomy": "node scripts/build-taxonomy.mjs",
    "update-data": "node scripts/update-all.mjs",
    "typecheck": "astro sync && tsrs --noEmit",
    "check": "tsrs --noEmit && oxlint --deny-warnings --report-unused-disable-directives && vitest run",
    "test": "vitest run",
    "firebase-deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@types/leaflet": "^1.9.22",
    "astro": "^7.4.12",
    "firebase": "^13.3.0",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.36.0",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}

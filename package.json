{
  "name": "compy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "astro build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "preview": "astro preview",
    "build-taxonomy": "node scripts/build-taxonomy.mjs",
    "update-data": "node scripts/update-all.mjs",
    "typecheck": "astro sync && tsrs --noEmit",
    "check": "tsrs --noEmit && oxlint --deny-warnings --report-unused-disable-directives && vitest run",
    "test": "vitest run",
    "firebase-deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.3",
    "@types/leaflet": "^1.9.21",
    "astro": "^6.3.7",
    "firebase": "^12.13.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "firebase-tools": "^15.18.0",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}

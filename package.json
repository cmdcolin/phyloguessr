{
  "name": "compy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "astro build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "preview": "astro preview",
    "predep": "yarn build",
    "dep": "gh-pages -d dist  -t --nojekyll",
    "postdep": "git push --follow-tags",
    "build-taxonomy": "node scripts/build-taxonomy.mjs",
    "update-data": "node scripts/update-all.mjs",
    "test": "vitest run",
    "firebase-deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.2",
    "@types/leaflet": "^1.9.21",
    "astro": "^6.3.1",
    "firebase": "^12.13.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.17.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}

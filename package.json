{
  "name": "compy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "astro build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "preview": "astro preview",
    "predep": "yarn build",
    "dep": "gh-pages -d dist  -t --nojekyll",
    "postdep": "git push --follow-tags",
    "build-taxonomy": "node scripts/build-taxonomy.mjs",
    "update-data": "node scripts/update-all.mjs",
    "check": "tsc --noEmit && eslint --report-unused-disable-directives --max-warnings 0 && vitest run",
    "test": "vitest run",
    "firebase-deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.3",
    "@types/leaflet": "^1.9.21",
    "astro": "^6.3.7",
    "firebase": "^12.13.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.18.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
